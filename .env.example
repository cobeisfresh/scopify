# SQLite database file (Prisma). Lives in the git-ignored server/data/ directory.
DATABASE_URL="file:./server/data/app.db"

# OPTIONAL. Port the Hono server listens on (defaults to 8787).
# PORT=8787

# OPTIONAL. Restricts the API to a specific web origin (defaults to '*').
# CORS_ORIGIN=

# Used once by `npm run db:seed` to create the first staff (PM) login.
STAFF_SEED_EMAIL="pm@example.com"
STAFF_SEED_PASSWORD="change-me"
STAFF_SEED_NAME="COBE Staff"
